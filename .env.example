# DrishtiPrep — Environment Variables
# Copy this file to apps/web/.env.local and fill in your values.
# Never commit .env.local — it's in .gitignore.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe to expose publicly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (safe to expose publicly — RLS enforces security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key (NEVER expose — bypasses RLS).
# Required only for one-off admin/backfill scripts (e.g. Manana memory backfill)
# and the Manana cron worker which writes episodes for any user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret the Manana Sunday cron sends as `Authorization: Bearer ...`.
# Vercel injects this automatically for scheduled cron invocations when set in
# the project's Environment Variables. Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ─── AI ──────────────────────────────────────────────────────────────────────
# Google Gemini API key for AI-powered answer feedback
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: tune the TTS throttle interval (ms between calls).
# Default 6500 = safe for free tier (10 RPM). Set to 2000 once paid billing
# is enabled to speed up Manana long-form renders ~3x. Floor: 500.
# GEMINI_TTS_MIN_INTERVAL_MS=6500

# ElevenLabs API key for Manana branding sounds / voice TTS A/B tests
# Get one at: https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# Optional: override the voice used by the test:manana-elevenlabs script.
# Default is "Sarah" (EXAVITQu4vr4xnSDxMaL) — a warm multilingual female voice.
# Browse alternatives at https://elevenlabs.io/voices and paste the voice_id here.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Optional: override the TTS model. Default is eleven_multilingual_v2.
# Alternatives: eleven_turbo_v2_5 (faster), eleven_flash_v2_5 (lowest latency).
# ELEVENLABS_VOICE_MODEL=eleven_multilingual_v2

# Optional: override the default Gemini model IDs without redeploying.
# Defaults: GEMINI_MODEL_FLASH=gemini-2.5-flash, GEMINI_MODEL_PRO=gemini-2.5-pro
# Examples for cost/quality A/B:
#   GEMINI_MODEL_FLASH=gemini-2.5-flash-lite   # ~3× cheaper, slight quality drop
#   GEMINI_MODEL_PRO=gemini-3.1-pro-preview    # premium reasoning ($2/$12)
# GEMINI_MODEL_FLASH=
# GEMINI_MODEL_PRO=

# TTS model overrides. Defaults use the 2.5 preview TTS models, which Google
# has scheduled for retirement in line with the **Oct 16 2026** shutdown of
# the 2.5 text family. Recommended replacement is `gemini-3.1-flash-tts-preview`.
# Flip these only after A/B testing Nepali speech quality on the 3.1 model.
# GEMINI_MODEL_TTS_FLASH=
# GEMINI_MODEL_TTS_PRO=

# Optional: force the Pro model for the question-editor "regenerate
# explanation" path, bypassing the Flash-first attempt. Set to "1" when an
# editor needs the highest-quality output for a flagged question.
# GEMINI_EXPLANATION_FORCE_PRO=

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Required for production. Create a free database at https://upstash.com
# Without these, rate limiting is disabled (safe for local dev only).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── Transactional Email (Resend) ────────────────────────────────────────────
# Used to notify users when their identity verification is approved or rejected.
# Sign up free at https://resend.com (100 emails/day on free tier).
# Without these, email sending is disabled (the app still works; users see
# their status in-app on next login).
RESEND_API_KEY=re_your_api_key_here
# "From" address. Use the Resend onboarding domain for testing
# (onboarding@resend.dev — only delivers to your verified email) or your
# own verified domain in production.
EMAIL_FROM="DrishtiPrep <noreply@drishtiprep.example>"
# Public app URL used in outbound email links (no trailing slash).
NEXT_PUBLIC_APP_URL=https://drishti-prep.vercel.app
