# DrishtiPrep — Environment Variables
# Copy this file to apps/web/.env.local and fill in your values.
# Never commit .env.local — it's in .gitignore.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe to expose publicly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (safe to expose publicly — RLS enforces security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── AI ──────────────────────────────────────────────────────────────────────
# Google Gemini API key for AI-powered answer feedback
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default Gemini model IDs without redeploying.
# Defaults: GEMINI_MODEL_FLASH=gemini-2.5-flash, GEMINI_MODEL_PRO=gemini-2.5-pro
# Examples for cost/quality A/B:
#   GEMINI_MODEL_FLASH=gemini-2.5-flash-lite   # ~3× cheaper, slight quality drop
#   GEMINI_MODEL_PRO=gemini-3.1-pro-preview    # premium reasoning ($2/$12)
# GEMINI_MODEL_FLASH=
# GEMINI_MODEL_PRO=

# Optional: force the Pro model for the question-editor "regenerate
# explanation" path, bypassing the Flash-first attempt. Set to "1" when an
# editor needs the highest-quality output for a flagged question.
# GEMINI_EXPLANATION_FORCE_PRO=

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Required for production. Create a free database at https://upstash.com
# Without these, rate limiting is disabled (safe for local dev only).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# ─── Transactional Email (Resend) ────────────────────────────────────────────
# Used to notify users when their identity verification is approved or rejected.
# Sign up free at https://resend.com (100 emails/day on free tier).
# Without these, email sending is disabled (the app still works; users see
# their status in-app on next login).
RESEND_API_KEY=re_your_api_key_here
# "From" address. Use the Resend onboarding domain for testing
# (onboarding@resend.dev — only delivers to your verified email) or your
# own verified domain in production.
EMAIL_FROM="DrishtiPrep <noreply@drishtiprep.example>"
# Public app URL used in outbound email links (no trailing slash).
NEXT_PUBLIC_APP_URL=https://drishti-prep.vercel.app

